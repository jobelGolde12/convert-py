APP_NAME="Convert API"
APP_URL="http://localhost:8000"
ENV="development"
SECRET_KEY="dev-secret-key-change-me"
UPLOAD_SECRET="dev-only-change-me"

# --- Database ---
# Local SQLite (default — used when TURSO_DATABASE_URL is empty)
DATABASE_URL="sqlite:///./dev.db"

# Turso / libSQL (optional — when set, overrides DATABASE_URL)
# Format: libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Redis ---
REDIS_URL="redis://127.0.0.1:6379"

# --- Quotas & Retention ---
RETENTION_ANON_HOURS=1
ANON_CONVERSIONS_PER_DAY=5
ANON_REQ_PER_MIN=60

# --- LibreOffice ---
LO_CONCURRENCY=1
LO_TIMEOUT_MS=900000
LO_PROFILE_ROOT="/tmp/lo-profiles"

# --- R2 / S3 Storage (optional) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="convert-files"
R2_PUBLIC_URL=""

# --- CORS ---
# Allowed origins as a JSON list, e.g. ["https://convert.example"]
# Empty list = same-origin only (recommended).
CORS_ORIGINS="[]"
